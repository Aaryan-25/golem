#!/usr/bin/env python3
# Part of Golem: GADA, the editor; MAP.md section 5.7.
"""golem-preview FILE: a live preview of an HTML, Markdown or SVG file, or any text file
(shown as text, with Hindi / Sanskrit letters joined properly).

A tiny web server on this computer only (127.0.0.1) shows the file's folder; a small
window of its own (golem-view: pages from this computer only, no bars) shows the page. Whenever the file changes on disk (the
editor autosaves ~2 s after you stop typing), the page reloads by itself, keeping its
scroll position. Closing the window stops the server.
"""
import html
import http.server
import os
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse

if len(sys.argv) != 2 or not os.path.isfile(sys.argv[1]):
    sys.exit("usage: golem-preview FILE")
FILE = os.path.realpath(sys.argv[1])
ROOT = os.path.dirname(FILE)
NAME = os.path.basename(FILE)
VOID, MIST, TEXT, PALE = (os.environ.get(k, d) for k, d in (
    ("GOLEM_VOID", "#050506"), ("GOLEM_MIST", "#6f7484"), ("GOLEM_TEXT", "#c8ccd8"), ("GOLEM_PALE", "#e6e9f2")))

RELOAD = b"""<script>(function(){
  var k='golem-scroll:'+location.pathname;
  try{var y=sessionStorage.getItem(k); if(y) window.scrollTo(0, +y);}catch(e){}
  var s=new EventSource('/__golem_changes?f='+encodeURIComponent(location.pathname));
  s.onmessage=function(){ try{sessionStorage.setItem(k, window.scrollY);}catch(e){} location.reload(); };
})();</script>"""

MD_STYLE = f"""<style>
body{{background:{VOID};color:{TEXT};font:16px/1.6 Inter,"DejaVu Sans",sans-serif;max-width:46em;margin:2em auto;padding:0 1.5em}}
h1,h2,h3,h4{{color:{PALE};font-weight:600;letter-spacing:.02em}} a{{color:{PALE}}}
code,pre{{font-family:"DejaVu Sans Mono",monospace;background:#14161c;border-radius:3px}}
code{{padding:.1em .3em}} pre{{padding:1em;overflow:auto}} hr{{border:0;border-top:1px solid {MIST}}}
blockquote{{color:{MIST};border-left:2px solid {MIST};margin:0;padding-left:1em}}
table{{border-collapse:collapse}} td,th{{border:1px solid #14161c;padding:.3em .6em}}
img{{max-width:100%}}
</style>"""


def markdown_to_html(text):
    try:
        import markdown
        body = markdown.markdown(text, extensions=["fenced_code", "tables", "sane_lists"])
    except ImportError:
        body = "<pre>" + html.escape(text) + "</pre>"
    return "<!doctype html><meta charset=utf-8>" + MD_STYLE + body


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k):
        super().__init__(*a, directory=ROOT, **k)

    def log_message(self, *a):
        pass

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def _local(self, url_path):
        p = os.path.realpath(os.path.join(ROOT, urllib.parse.unquote(url_path).lstrip("/")))
        return p if p == ROOT or p.startswith(ROOT + os.sep) else None

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        if url.path == "/__golem_changes":
            return self.changes(urllib.parse.parse_qs(url.query).get("f", ["/"])[0])
        path = self._local(url.path)
        if path and os.path.isfile(path) and path.lower().endswith((".md", ".markdown", ".html", ".htm")):
            with open(path, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
            page = markdown_to_html(text) if path.lower().endswith((".md", ".markdown")) else text
            data = page.encode("utf-8")
            low = data.lower()
            i = low.rfind(b"</body>")
            data = data[:i] + RELOAD + data[i:] if i >= 0 else data + RELOAD
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        if path == FILE:
            # any other text file: shown as text, in fonts that join Devanagari letters properly
            with open(path, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
            page = ("<!doctype html><meta charset=utf-8>" + MD_STYLE.replace("max-width:46em", "max-width:none")
                    + "<pre style='font:17px/1.7 \"Lohit Devanagari\",\"DejaVu Sans Mono\",monospace;"
                    + "background:none;white-space:pre-wrap'>" + html.escape(text) + "</pre>").encode("utf-8")
            data = page + RELOAD
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        return super().do_GET()

    def changes(self, page):
        """Tell the page to reload when any file in the folder changes (its CSS and JS too)."""
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()

        def stamp():
            newest = 0.0
            for dirpath, dirs, files in os.walk(ROOT):
                dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
                for n in files:
                    try:
                        newest = max(newest, os.stat(os.path.join(dirpath, n)).st_mtime)
                    except OSError:
                        pass
                if dirpath.count(os.sep) - ROOT.count(os.sep) > 2:
                    dirs[:] = []
            return newest

        last = stamp()
        try:
            while True:
                time.sleep(0.5)
                now = stamp()
                if now != last:
                    last = now
                    self.wfile.write(b"data: changed\n\n")
                    self.wfile.flush()
                else:
                    self.wfile.write(b": still here\n\n")
                    self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


server = Server(("127.0.0.1", 0), Handler)
threading.Thread(target=server.serve_forever, daemon=True).start()
url = f"http://127.0.0.1:{server.server_address[1]}/{urllib.parse.quote(NAME)}"
# golem-view: a tiny window that can only show pages from this computer (never the internet)
try:
    subprocess.run(["golem-view", "--class", "golem-preview", url])
except FileNotFoundError:
    sys.exit("golem-preview: golem-view is missing")
finally:
    server.shutdown()
