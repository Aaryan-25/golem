#!/usr/bin/env python3
# Part of Golem: GADA, the editor; MAP.md section 5.7.
"""golem-map FOLDER [--here FILE:LINE] [--low]: the program map (F12 in the editor).

The Python files in FOLDER as a dark 3D landscape: each file a district, each function a tower (taller = longer,
brighter = changed recently, ember = the file has a mistake), light beams for calls, and the gada over the function
I am in. The code is only read, never run. A click on a tower prints "OPEN file:line" for the editor.
"""
import ast
import http.server
import json
import os
import socketserver
import subprocess
import sys
import threading
import time

SKIP = {".git", "__pycache__", "node_modules", ".venv", "venv", "env", ".mypy_cache", "result"}
MAX_FILES = 120


def files(root):
    out = []
    for d, dirs, fs in os.walk(root):
        dirs[:] = sorted(x for x in dirs if x not in SKIP and not x.startswith("."))
        out += [os.path.join(d, f) for f in sorted(fs) if f.endswith(".py")]
        if len(out) >= MAX_FILES:
            break
    return out[:MAX_FILES]


def read_map(root):
    now = time.time()
    districts, towers = [], []
    for path in files(root):
        rel = os.path.relpath(path, root)
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                src = fh.read()
            age = now - os.path.getmtime(path)
        except OSError:
            continue
        d = {"name": rel, "path": path, "mistake": None, "towers": []}
        try:
            tree = ast.parse(src)
        except SyntaxError as e:
            d["mistake"] = f"line {e.lineno}: {e.msg}"
            tree = None
        for node in ast.walk(tree) if tree else []:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                calls = sorted({c.func.id if isinstance(c.func, ast.Name) else c.func.attr
                                for c in ast.walk(node) if isinstance(c, ast.Call)
                                and isinstance(c.func, (ast.Name, ast.Attribute))})
                t = {"id": len(towers), "name": node.name, "file": path, "line": node.lineno,
                     "end": getattr(node, "end_lineno", node.lineno), "calls": calls, "district": len(districts),
                     "fresh": max(0.0, 1 - age / (7 * 86400))}          # 1 = changed just now, 0 = a week or more
                t["length"] = t["end"] - t["line"] + 1
                towers.append(t)
                d["towers"].append(t["id"])
        if not d["towers"]:                         # a file with no functions still gets one low building
            towers.append({"id": len(towers), "name": "(the file itself)", "file": path, "line": 1, "end": 1, "length": 3,
                           "calls": [], "district": len(districts), "fresh": max(0.0, 1 - age / (7 * 86400))})
            d["towers"].append(len(towers) - 1)
        districts.append(d)
    names = {}
    for t in towers:
        names.setdefault(t["name"], []).append(t["id"])
    def targets(t, c):     # a name used by several functions: only the one in the same file, if any (no guessing)
        ids = names.get(c, [])
        return ids if len(ids) == 1 else [o for o in ids if towers[o]["district"] == t["district"]][:1]
    beams = sorted({(t["id"], o) for t in towers for c in t["calls"] for o in targets(t, c) if o != t["id"]})
    return {"root": os.path.basename(os.path.abspath(root)), "districts": districts, "towers": towers,
            "beams": [list(b) for b in beams][:2000]}


def here_tower(data, here):
    if not here or ":" not in here:
        return None
    f, _, ln = here.rpartition(":")
    f = os.path.realpath(f)
    best = None
    for t in data["towers"]:
        if os.path.realpath(t["file"]) == f and t["line"] <= int(ln or 0) <= t["end"]:
            if best is None or t["length"] < best["length"]:
                best = t
    return best["id"] if best else None


def main(a):
    if not a:
        sys.exit("usage: golem-map FOLDER [--here FILE:LINE] [--low]")
    root = os.path.realpath(a[0])
    here = a[a.index("--here") + 1] if "--here" in a and a.index("--here") + 1 < len(a) else None
    data = read_map(root)
    data["here"] = here_tower(data, here)
    data["low"] = "--low" in a
    page = os.environ.get("GOLEM_MAP_PAGE", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "map.html"))
    if "--json" in a:                                  # for the tests
        print(json.dumps(data))
        return

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *x):
            pass

        def send(self, body, kind):
            self.send_response(200)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            with open(page, encoding="utf-8") as fh:
                self.send(fh.read().replace("__MAP__", json.dumps(data)).encode(), "text/html; charset=utf-8")

        def do_POST(self):
            try:
                t = data["towers"][int(json.loads(self.rfile.read(int(self.headers.get("Content-Length", "0"))))["tower"])]
                print(f"OPEN {t['file']}:{t['line']}", flush=True)
            except (ValueError, KeyError, IndexError, TypeError):
                pass
            self.send(b"{}", "application/json")

    class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True

    server = Server(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        subprocess.run(["golem-view", "--class", "golem-map", f"http://127.0.0.1:{server.server_address[1]}/"])
    finally:
        server.shutdown()


if __name__ == "__main__":
    main(sys.argv[1:])
