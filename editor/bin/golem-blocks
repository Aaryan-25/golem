#!/usr/bin/env python3
"""golem-blocks FILE: the block builder for FILE (.py, .js or .lua).

A tiny web server on this computer only (127.0.0.1) serves the block page and Blockly; a
Firefox window of its own (fresh profile, no bars) shows it. As you snap blocks together, the
page sends the code here and it is written into FILE (the editor shows it at once). The blocks
themselves are kept next to it in FILE.blocks.json, so F10 later brings the same picture back.

If FILE has text the blocks did not write (or it was changed by hand since), the page asks
before replacing it. Closing the window stops the server.
"""
import hashlib
import http.server
import json
import os
import shutil
import socketserver
import subprocess
import sys
import tempfile
import threading

LANGS = {".py": "python", ".js": "javascript", ".mjs": "javascript", ".lua": "lua"}

if len(sys.argv) != 2:
    sys.exit("usage: golem-blocks FILE")
FILE = os.path.realpath(sys.argv[1])
LANG = LANGS.get(os.path.splitext(FILE)[1].lower())
if not LANG:
    sys.exit("golem-blocks: blocks make Python (.py), JavaScript (.js) or Lua (.lua) files")
SIDE = FILE + ".blocks.json"
HERE = os.path.dirname(os.path.realpath(__file__))
PAGE = os.environ.get("GOLEM_BLOCKS_PAGE", os.path.join(HERE, "..", "blocks.html"))
BLOCKLY = os.environ.get("GOLEM_BLOCKLY", "")


def digest(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def current_text():
    try:
        with open(FILE, encoding="utf-8") as fh:
            return fh.read()
    except FileNotFoundError:
        return ""


def side():
    try:
        with open(SIDE, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (FileNotFoundError, ValueError):
        return {}


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, kind):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/":
            s = side()
            text = current_text()
            hand = bool(text.strip()) and s.get("code_hash") != digest(text)
            cfg = {"lang": LANG, "name": os.path.basename(FILE), "blocks": s.get("blocks"), "handEdited": hand}
            with open(PAGE, encoding="utf-8") as fh:
                page = fh.read()
            page = (page.replace("__CONFIG__", json.dumps(cfg))
                    .replace("__LANG__", LANG).replace("__NAME__", os.path.basename(FILE)))
            return self.send(200, page.encode("utf-8"), "text/html; charset=utf-8")
        if path.startswith("/blockly/") and BLOCKLY:
            rel = os.path.normpath(path[len("/blockly/"):])
            full = os.path.realpath(os.path.join(BLOCKLY, rel))
            if full.startswith(os.path.realpath(BLOCKLY) + os.sep) and os.path.isfile(full):
                kind = {".js": "text/javascript", ".svg": "image/svg+xml", ".png": "image/png",
                        ".cur": "image/x-icon", ".gif": "image/gif", ".mp3": "audio/mpeg"}.get(
                    os.path.splitext(full)[1], "application/octet-stream")
                with open(full, "rb") as fh:
                    return self.send(200, fh.read(), kind)
        self.send(404, b"not here", "text/plain")

    def do_POST(self):
        if self.path != "/save":
            return self.send(404, b"{}", "application/json")
        try:
            n = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(min(n, 5_000_000)))
            code = data.get("code", "")
            if not isinstance(code, str):
                raise ValueError("no code")
            tmp = FILE + ".golem-tmp"
            with open(tmp, "w", encoding="utf-8") as fh:      # write whole, then swap: never half a file
                fh.write(code)
            os.replace(tmp, FILE)
            with open(SIDE, "w", encoding="utf-8") as fh:
                json.dump({"blocks": data.get("blocks"), "code_hash": digest(code), "lang": LANG}, fh)
            answer = {"ok": True}
        except Exception as e:  # tell the page, plainly
            answer = {"ok": False, "error": "not written: " + str(e)[:120]}
        self.send(200, json.dumps(answer).encode(), "application/json")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


server = Server(("127.0.0.1", 0), Handler)
threading.Thread(target=server.serve_forever, daemon=True).start()
url = f"http://127.0.0.1:{server.server_address[1]}/"

USER_JS = """
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("app.update.enabled", false);
user_pref("browser.sessionstore.resume_from_crash", false);
"""
USER_CHROME = "#navigator-toolbox, #TabsToolbar, #nav-bar, #PersonalToolbar { visibility: collapse !important; }"

profile = tempfile.mkdtemp(prefix="golem-blocks-")
os.makedirs(os.path.join(profile, "chrome"))
with open(os.path.join(profile, "user.js"), "w") as fh:
    fh.write(USER_JS)
with open(os.path.join(profile, "chrome", "userChrome.css"), "w") as fh:
    fh.write(USER_CHROME)
browser = os.environ.get("GOLEM_PREVIEW_BROWSER", "firefox")
try:
    subprocess.run([browser, "--no-remote", "--new-instance", "--profile", profile,
                    "--class", "golem-blocks", "--name", "golem-blocks", url])
except FileNotFoundError:
    sys.exit(f"golem-blocks: the browser '{browser}' is missing")
finally:
    server.shutdown()
    shutil.rmtree(profile, ignore_errors=True)
