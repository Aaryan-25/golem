#!/usr/bin/env bash
# golem-run FILE: runs a file with its language, in the file's own folder.
# Which languages exist: editor/languages.nix (add a name there, then golem-update).
set -u
f=$(realpath -- "${1:?usage: golem-run FILE}")
dir=$(dirname -- "$f"); name=$(basename -- "$f"); ext=${name##*.}; [ "$ext" = "$name" ] && ext=""
cd "$dir" || exit 1
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

need() { # need PROGRAM "language" "name in languages.nix"
  command -v "$1" >/dev/null && return 0
  printf '\n  %s is not in Golem yet.\n  Add "%s" to editor/languages.nix in your Golem repo, then run golem-update.\n' "$2" "$3"
  exit 127
}

# no extension: look at the first line (#!/usr/bin/env python3 ...)
if [ -z "$ext" ] && head -c2 -- "$f" | grep -q '#!'; then ext=shebang; fi

printf '\033[2m── %s ──\033[0m\n' "$name"
start=$(date +%s.%N)
case "$ext" in
  py)            need python3 Python python3; python3 -- "$f" ;;
  sh|bash)       need bash Bash bash; bash -- "$f" ;;
  fish)          need fish Fish fish; fish -- "$f" ;;
  lua)           need lua Lua lua; lua -- "$f" ;;
  js|mjs|cjs)    need node JavaScript nodejs; node -- "$f" ;;
  ts)            need node TypeScript nodejs; node --experimental-strip-types -- "$f" ;;
  c)             need gcc C gcc; gcc -O1 -o "$tmp/a" -- "$f" -lm && "$tmp/a" ;;
  cc|cpp|cxx)    need g++ C++ gcc; g++ -O1 -o "$tmp/a" -- "$f" && "$tmp/a" ;;
  java)          need java Java jdk; java -- "$f" ;;
  go)            need go Go go; HOME="$tmp" go run -- "$f" ;;
  rs)            need rustc Rust rustc; rustc -o "$tmp/a" -- "$f" && "$tmp/a" ;;
  rb)            need ruby Ruby ruby; ruby -- "$f" ;;
  php)           need php PHP php; php -- "$f" ;;
  pl)            need perl Perl perl; perl -- "$f" ;;
  r|R)           need Rscript R R; Rscript -- "$f" ;;
  hs)            need runghc Haskell ghc; runghc -- "$f" ;;
  html|htm|md|markdown|svg)
                 printf '\n  This kind of file is shown, not run: press F6 for the live preview.\n'; exit 0 ;;
  shebang)       chmod u+x -- "$f" 2>/dev/null; "$f" ;;
  *)             printf '\n  Golem does not know how to run .%s files yet.\n' "${ext:-(no extension)}"; exit 2 ;;
esac
code=$?
end=$(date +%s.%N)
printf '\n\033[2m── finished%s in %.1f s · Enter closes this panel ──\033[0m\n' \
  "$([ $code -ne 0 ] && echo " with error $code")" "$(echo "$end - $start" | bc)"
exit $code
