#!/usr/bin/env bash
# golem-open FILE|LINK: opens what the editor can't show itself, by the file's contents.
#   pictures -> imv   music, video -> mpv   PDF -> zathura
#   Word (.docx) and Excel (.xlsx) -> inside the editor, as a document or a table (golem-office)
#   links -> the Gate's browser, once the Gate is built (there is no Firefox in Golem)
# Prints one line saying what it did. Exit 3 = it is text (the editor opens it itself).
# Exit 6 = a Word or Excel file: the line printed is the path of the copy the editor opens.
set -u
t=${1:?usage: golem-open FILE|LINK}

start() {
  command -v "$1" >/dev/null || { echo "${1^^} IS MISSING, SO THIS CAN'T OPEN"; exit 5; }
  setsid -f "$@" >/dev/null 2>&1 </dev/null
}

case "$t" in
  http://*|https://*|www.*)
    logger -t zone "Editor: a link was not opened (the Gate isn't built yet): $t" 2>/dev/null
    echo "LINKS OPEN IN THE GATE'S BROWSER, WHICH ISN'T BUILT YET"; exit 0 ;;
esac

[ -e "$t" ] || { echo "NOT FOUND: $t"; exit 1; }
f=$(realpath -- "$t"); b=$(basename -- "$f")
m=$(file -b --mime-type -- "$f")
case "$m" in
  text/*|inode/x-empty|application/json|application/x-ndjson|*xml|*javascript)
    exit 3 ;;
  image/*)
    start imv "$f"; echo "OPENING THE PICTURE $b" ;;
  audio/*|video/*)
    start mpv --force-window=yes "$f"; echo "PLAYING $b" ;;
  application/pdf)
    start zathura "$f"; echo "OPENING THE PDF $b" ;;
  application/msword|application/vnd.ms-*|application/vnd.openxmlformats-officedocument.*|application/vnd.oasis.opendocument.*|application/rtf)
    golem-office open "$f"; exit $(( $? == 0 ? 6 : 4 )) ;;
  inode/directory)
    echo "THAT IS A FOLDER"; exit 1 ;;
  *)
    echo "GOLEM CAN'T OPEN THIS KIND OF FILE YET ($m)"; exit 4 ;;
esac
